<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>KB 대출 플랫폼</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f1f0ed;color:#242424;font-family:-apple-system,BlinkMacSystemFont,"Noto Sans KR","Apple SD Gothic Neo",Arial,sans-serif}
.phone{width:390px;max-width:100%;height:820px;position:relative;margin:24px auto;background:#fff;border-radius:28px;overflow:hidden;box-shadow:0 18px 50px rgba(45,39,25,.10);border:1px solid #e6e2d9}
.header{padding:17px 19px 0;display:flex;align-items:center;gap:8px}.kb-brand{display:flex;align-items:center;gap:7px;margin-left:2px;font-size:14px;font-weight:800;letter-spacing:-.35px;color:#39362f}.kb-mark{width:28px;height:28px;flex:none;background:url("data:image/png;base64,") center/contain no-repeat;color:transparent;font-size:0;box-shadow:none}.back{font-size:28px;line-height:1}.title{padding:17px 19px 0;font-size:23px;font-weight:800;letter-spacing:-.6px}
.teaser{padding:23px 19px 21px}.teaser-label{font-size:12px;color:#817d74;margin:0 0 6px}.teaser-value{font-size:27px;font-weight:800;letter-spacing:-.8px}.teaser-value.bump{animation:bump .22s ease}@keyframes bump{0%{opacity:.4;transform:translateY(4px)}100%{opacity:1;transform:translateY(0)}}
.teaser-sub{margin-top:8px;font-size:11.5px;color:#817d74}.teaser-sub b{color:#222}.cta{display:inline-flex;margin-top:14px;background:#ffca05;color:#252525;border:0;border-radius:10px;padding:10px 15px;font-size:12px;font-weight:800}
.divider{height:7px;background:#f7f4ec}.ai-head{padding:16px 19px 8px;display:flex;align-items:center;gap:7px;font-size:12.5px;font-weight:800;color:#4a463e}.spark{width:21px;height:21px;border-radius:7px;background:#fff1c2;display:flex;align-items:center;justify-content:center;font-size:12px}
.list{padding:5px 17px 19px;display:flex;flex-direction:column;gap:9px}
.card{border:1px solid #e8e5df;border-radius:14px;padding:13px 14px;cursor:pointer;background:#fff;transition:.18s ease;box-shadow:0 1px 2px rgba(0,0,0,.02)}
.card:hover{transform:translateY(-1px);box-shadow:0 5px 16px rgba(0,0,0,.06)}.card.selected{border:1.5px solid #ffd338;box-shadow:0 5px 18px rgba(244,193,0,.12)}
.card-top{display:flex;align-items:center;gap:11px}.logo{width:42px;height:42px;border-radius:12px;flex:none;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.affiliate-logo{width:32px;height:32px;object-fit:contain;display:block}
.logoMark{font-size:10px;font-weight:900;letter-spacing:-.6px;line-height:1.05;text-align:center;z-index:1}.kbinsure{background:#eef5ff}.kbinsure .logoMark{color:#1167d8}.kbbank{background:#fff8d9}.kbbank .logoMark,.kbcard .logoMark,.kbsaving .logoMark{color:#111}.kbcard{background:#f1f3f5}.kbsaving{background:#eef8f0}.kbsaving:before{content:none}
 .kbbank:before{content:none}.kbcard:before{content:none}}.kbinsure:before{content:"";position:absolute;width:14px;height:16px;border-radius:8px 8px 10px 10px;background:#1e73e8;top:5px;right:5px;opacity:.12}
.card-info{flex:1;min-width:0}.name{font-size:14px;font-weight:800;letter-spacing:-.3px}.desc{font-size:11px;color:#888;margin-top:4px}.right{display:flex;align-items:center;gap:7px}.badge{font-size:9px;font-weight:800;background:#fff0a9;border-radius:999px;padding:4px 7px;color:#5e4b00}.chev{font-size:17px;color:#aaa;transition:transform .18s}.card.selected .chev{transform:rotate(180deg)}
.reason{max-height:0;overflow:hidden;opacity:0;font-size:11.5px;color:#555;line-height:1.5;transition:max-height .2s ease,opacity .2s ease,margin-top .2s ease}.card.selected .reason{max-height:90px;opacity:1;margin-top:11px;padding-top:10px;border-top:1px solid #eee}.reason b{color:#222}
.note{padding:0 19px 22px;color:#aaa;font-size:9.5px;line-height:1.5}

.tab-pane{display:none;height:calc(100% - 68px);overflow-y:auto;padding-bottom:82px;scrollbar-width:none}.tab-pane::-webkit-scrollbar{display:none}.tab-pane.active{display:block}
.bottom-nav{position:absolute;left:0;right:0;bottom:0;height:68px;background:rgba(255,253,248,.98);border-top:1px solid #ebe4d7;display:flex;z-index:5}
.nav-item{flex:1;border:0;background:#fffdf8;color:#8b95a1;font-size:11px;font-weight:700;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;cursor:pointer}
.nav-item.active{color:#242424}.nav-icon{font-size:18px;line-height:1}.nav-dot{width:4px;height:4px;border-radius:50%;background:#ffd338;opacity:0}.nav-item.active .nav-dot{opacity:1}
.sim-wrap{padding:19px;background:#fffdf9;min-height:738px}.sim-top{display:flex;justify-content:space-between;align-items:center;font-size:15px;font-weight:800;color:#2c2a26}.sim-kb-badge{font-size:10px;color:#7d6507;background:#fff0bc;border-radius:999px;padding:5px 8px;font-weight:800}.sim-label{font-size:12px;color:#8b95a1;margin-top:22px}.sim-balance{font-size:30px;font-weight:850;margin-top:4px;letter-spacing:-.7px}.sim-meta{font-size:12px;color:#8b95a1;margin-top:4px}
.sim-ai{margin-top:18px;padding:13px 14px;border-radius:14px;background:#fff6dc;border:1px solid #f1e2b7;display:flex;gap:9px;align-items:center}.sim-aiIcon{width:28px;height:28px;border-radius:50%;background:#ffca05;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:900;flex:none}.sim-aiText{font-size:12px;font-weight:750;line-height:1.4}
.sim-section{margin-top:23px;font-size:14px;font-weight:850;color:#2b2925}.sim-amountRow{display:flex;justify-content:space-between;align-items:flex-end;margin-top:8px}.sim-amount{font-size:23px;font-weight:850}.sim-saving{font-size:11px;color:#907b36}.sim-slider{margin-top:13px}.sim-slider input{width:100%;accent-color:#f2bd00;cursor:pointer}.sim-ends{display:flex;justify-content:space-between;color:#999;font-size:10px}
.sim-compare{margin-top:19px;background:#faf7ef;border-radius:14px;padding:15px}.sim-compareTitle{font-size:13px;font-weight:850;margin-bottom:12px}.sim-compareGrid{display:grid;grid-template-columns:1fr 24px 1fr;align-items:center;gap:6px}.sim-compareCard{padding:2px 4px}.sim-compareCard.after{background:#fff0c8;border-radius:10px;padding:10px}.sim-compareLabel{font-size:10px;color:#888}.sim-compareVal{font-size:17px;font-weight:850;margin-top:4px;letter-spacing:-.3px}.sim-compareSub{font-size:10px;color:#888;margin-top:5px}.sim-arrow{text-align:center;color:#aaa;font-size:20px}
.sim-bottom{margin-top:15px;padding-top:14px;border-top:1px solid #eee;display:flex;justify-content:space-between;align-items:center;gap:12px}.sim-bottomText{font-size:11px;color:#777;line-height:1.5}.sim-btn{border:0;background:#ffca05;border-radius:10px;padding:11px 13px;font-weight:850;font-size:11px;cursor:pointer;white-space:nowrap}.sim-note{margin-top:15px;color:#aaa;font-size:9.5px;line-height:1.45}
</style>
</head>
<body>
<div class="phone">
  <div class="header"><span class="back">‹</span><div class="kb-brand"><span class="kb-mark">KB</span><span>KB금융플랫폼</span></div></div>
  <div id="tab-loan" class="tab-pane active">
  
  <div class="teaser">
    <p class="teaser-label" id="teaserLabel">대출 한도 · 금리</p>
    <div class="teaser-value" id="teaserValue">? 만원 · ?%</div>
    <div class="teaser-sub" id="teaserSub">상품을 선택하면 <b>예상 월 이자</b>까지 보여드려요</div>
    <button class="cta">맞춤 대출 보기</button>
  </div>
  <div class="divider"></div>
  <div class="ai-head"><span class="spark">✦</span><span>AI가 KB금융그룹 상품을 비교했어요</span></div>
  <div class="list">

    <div class="card selected" data-amt="1,240만원" data-rate="4.2%" data-interest="43,400원" data-name="KB손해보험 계약대출" data-reason="보유한 보험계약을 기준으로 확인할 수 있는 대출이에요. 먼저 계약대출 조건을 확인해보세요.">
      <div class="card-top">
        <div class="logo kbinsure"><img class="affiliate-logo" src="data:image/png;base64," alt="KB손해보험 로고"></div>
        <div class="card-info"><div class="name">KB손해보험 계약대출</div><div class="desc">보유 계약 기반 · 연 4.2%</div></div>
        <div class="right"><span class="badge">AI 추천</span><span class="chev">⌄</span></div>
      </div>
      <div class="reason">✦ <span class="reasonText"></span></div>
    </div>

    <div class="card" data-amt="3,000만원" data-rate="5.015%" data-interest="125,375원" data-name="KB스타신용대출" data-reason="KB국민은행의 신용대출 상품이에요. 한도와 금리는 개인의 심사 결과에 따라 달라질 수 있어요.">
      <div class="card-top">
        <div class="logo kbbank"><img class="affiliate-logo" src="data:image/png;base64," alt="KB국민은행 로고"></div>
        <div class="card-info"><div class="name">KB스타신용대출</div><div class="desc">최저 연 5.015%</div></div>
        <div class="right"><span class="chev">⌄</span></div>
      </div>
      <div class="reason">✦ <span class="reasonText"></span></div>
    </div>

    <div class="card" data-amt="3,600만원" data-rate="15.9%" data-interest="477,000원" data-name="KB카드 장기카드대출" data-reason="금리는 상대적으로 높지만, 3,600만원까지 대출 가능해 큰 금액이 필요할 때 함께 확인해볼 수 있어요.">
      <div class="card-top">
        <div class="logo kbcard"><img class="affiliate-logo" src="data:image/png;base64," alt="KB국민카드 로고"></div>
        <div class="card-info"><div class="name">KB카드 장기카드대출</div><div class="desc">3,600만원 · 연 15.9%</div></div>
        <div class="right"><span class="chev">⌄</span></div>
      </div>
      <div class="reason">✦ <span class="reasonText"></span></div>
    </div>

    <div class="card" data-amt="최대 1억원" data-rate="6.9~19.9%" data-interest="조건 확인" data-name="KB저축은행 kiwi신용대출" data-reason="KB저축은행의 대표 신용대출 상품이에요. 한도는 최대 1억원, 금리는 연 6.9%~19.9% 범위예요.">
      <div class="card-top">
        <div class="logo kbsaving"><img class="affiliate-logo" src="data:image/png;base64," alt="KB저축은행 로고"></div>
        <div class="card-info"><div class="name">KB저축은행 kiwi신용대출</div><div class="desc">최대 1억원 · 연 6.9~19.9%</div></div>
        <div class="right"><span class="chev">⌄</span></div>
      </div>
      <div class="reason">✦ <span class="reasonText"></span></div>
    </div>

  </div>
  <div class="note">※ 화면은 UX 콘셉트 프로토타입입니다. KB저축은행 kiwi신용대출의 한도·금리 범위는 공식 상품 안내를 반영했고, 그 외 표시값은 예시값입니다.</div>
  </div>

  <div id="tab-sim" class="tab-pane">
    <div class="sim-wrap">
      <div class="sim-top"><span>보험계약대출 관리</span><span class="sim-kb-badge">KB AI</span></div>
      <div class="sim-label">현재 대출 잔액</div>
      <div class="sim-balance">8,420,000원</div>
      <div class="sim-meta">연 4.2% · 이번 달 이자 약 29,000원</div>

      <div class="sim-ai">
        <div class="sim-aiIcon">AI</div>
        <div class="sim-aiText" id="aiMsg">오늘 100만원 상환하면 다음 달 이자를 약 3,500원 줄일 수 있어요.</div>
      </div>

      <div class="sim-section">얼마를 상환할까요?</div>
      <div class="sim-amountRow">
        <div class="sim-amount" id="amount">1,000,000원</div>
        <div class="sim-saving" id="saving">다음 달 이자 약 3,500원 절감</div>
      </div>

      <div class="sim-slider">
        <input id="slider" type="range" min="0" max="8420000" step="100000" value="1000000" aria-label="상환 금액">
        <div class="sim-ends"><span>0원</span><span>전액 상환</span></div>
      </div>

      <div class="sim-compare">
        <div class="sim-compareTitle">상환 전 · 후</div>
        <div class="sim-compareGrid">
          <div class="sim-compareCard">
            <div class="sim-compareLabel">현재</div>
            <div class="sim-compareVal">8,420,000원</div>
            <div class="sim-compareSub">다음 달 이자 약 29,470원</div>
          </div>
          <div class="sim-arrow">›</div>
          <div class="sim-compareCard after">
            <div class="sim-compareLabel">상환 후</div>
            <div class="sim-compareVal" id="afterBalance">7,420,000원</div>
            <div class="sim-compareSub">다음 달 이자 <span id="afterInterest">25,970원</span></div>
          </div>
        </div>
      </div>

      <div class="sim-bottom">
        <div class="sim-bottomText" id="bottomText">오늘 100만원 상환 시<br>다음 달 이자를 약 3,500원 줄일 수 있어요.</div>
        <button class="sim-btn" id="payBtn" type="button">100만원 상환</button>
      </div>

      <div class="sim-note">※ 예시 화면입니다. 이자 계산은 잔액 × 연 4.2% ÷ 12로 단순 계산했습니다.</div>
    </div>
  </div>

  <div class="bottom-nav">
    <button class="nav-item active" id="loanTabBtn" type="button">
      <span class="nav-icon">⌂</span><span>대출 추천</span><span class="nav-dot"></span>
    </button>
    <button class="nav-item" id="simTabBtn" type="button">
      <span class="nav-icon">↗</span><span>상환 시뮬레이션</span><span class="nav-dot"></span>
    </button>
  </div>
</div>
<script>
(function(){
  const cards=document.querySelectorAll('.card'), value=document.getElementById('teaserValue'), label=document.getElementById('teaserLabel'), sub=document.getElementById('teaserSub');
  function selectCard(card){
    cards.forEach(c=>{c.classList.remove('selected');c.querySelector('.reasonText').textContent='';});
    card.classList.add('selected'); card.querySelector('.reasonText').textContent=card.dataset.reason;
    value.classList.remove('bump'); void value.offsetWidth; value.classList.add('bump');
    value.textContent=card.dataset.amt+' · '+card.dataset.rate;
    label.textContent=card.dataset.name+' 기준';
    sub.innerHTML = card.dataset.interest === '조건 확인' ? '한도·금리 <b>조건 확인</b>' : '예상 월 이자 <b>'+card.dataset.interest+'</b>'; 
  }
  cards.forEach(card=>card.addEventListener('click',()=>{
    if(card.classList.contains('selected')){
      card.classList.remove('selected'); card.querySelector('.reasonText').textContent='';
      value.textContent='? 만원 · ?%'; label.textContent='대출 한도 · 금리';
      sub.innerHTML='상품을 선택하면 <b>예상 월 이자</b>까지 보여드려요';
    }else selectCard(card);
  }));
  selectCard(cards[0]);
})();

  // 탭 전환
  const loanPane = document.getElementById('tab-loan');
  const simPane = document.getElementById('tab-sim');
  const loanTabBtn = document.getElementById('loanTabBtn');
  const simTabBtn = document.getElementById('simTabBtn');

  function switchTab(tab){
    const isLoan = tab === 'loan';
    loanPane.classList.toggle('active', isLoan);
    simPane.classList.toggle('active', !isLoan);
    loanTabBtn.classList.toggle('active', isLoan);
    simTabBtn.classList.toggle('active', !isLoan);
    window.scrollTo(0,0);
  }
  loanTabBtn.addEventListener('click', ()=>switchTab('loan'));
  simTabBtn.addEventListener('click', ()=>switchTab('sim'));

  // 상환 시뮬레이터
  const principal = 8420000, rate = 0.042;
  const slider = document.getElementById('slider');

  function won(n){ return Math.round(n).toLocaleString('ko-KR') + '원'; }
  function manwon(n){ return Math.round(n/10000).toLocaleString('ko-KR') + '만원'; }

  function updateSim(){
    const repay = Number(slider.value);
    const remain = Math.max(0, principal - repay);
    const current = principal * rate / 12;
    const next = remain * rate / 12;
    const save = current - next;

    document.getElementById('amount').textContent = won(repay);
    document.getElementById('saving').textContent = '월 이자 약 ' + Math.round(save).toLocaleString('ko-KR') + '원 절감';
    document.getElementById('afterBalance').textContent = won(remain);
    document.getElementById('afterInterest').textContent = won(next);

    if(repay === 0){
      document.getElementById('aiMsg').textContent = '상환 금액을 선택하면 다음 달 이자 절감액을 바로 확인할 수 있어요.';
      document.getElementById('bottomText').innerHTML = '상환금액을 선택하면<br>예상 결과를 보여드려요.';
      document.getElementById('payBtn').textContent = '금액 선택';
    }else{
      document.getElementById('aiMsg').textContent = '오늘 ' + manwon(repay) + ' 상환하면 다음 달 이자를 약 ' + Math.round(save).toLocaleString('ko-KR') + '원 줄일 수 있어요.';
      document.getElementById('bottomText').innerHTML = '오늘 ' + manwon(repay) + ' 상환 시<br>다음 달 이자를 약 ' + Math.round(save).toLocaleString('ko-KR') + '원 줄일 수 있어요.';
      document.getElementById('payBtn').textContent = manwon(repay) + ' 상환';
    }
  }
  slider.addEventListener('input', updateSim);
  updateSim();

</script>
</body>
</html>
